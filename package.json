{
  "name": "@chatluna/patchbay",
  "version": "0.1.12",
  "description": "Cordis 4 patches for Koishi, Satori, Satori adapters and Cordis plugins, wired into yarn, pnpm or npm",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChatLunaLab/patchbay.git"
  },
  "bugs": {
    "url": "https://github.com/ChatLunaLab/patchbay/issues"
  },
  "keywords": [
    "cordis",
    "koishi",
    "satori",
    "patch",
    "chatluna"
  ],
  "bin": "lib/cli.js",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "patches",
    "patchbay.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "yarn build && node --test tests/*.test.ts",
    "verify": "node scripts/refresh.ts verify",
    "refresh": "node scripts/refresh.ts",
    "prepack": "yarn build"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "7.0.2"
  },
  "packageManager": "yarn@4.18.0"
}
